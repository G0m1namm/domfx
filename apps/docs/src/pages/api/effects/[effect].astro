---
import { Code } from 'astro:components';
import DocsApiTable from '../../../components/DocsApiTable.astro';
import DocsEffectLab from '../../../components/DocsEffectLab.astro';
import DocsEffectLinks from '../../../components/docs-effect-links.astro';
import DocsEffectControls from '../../../components/docs-effect-controls.astro';
import DocsSharedOptions from '../../../components/docs-shared-options.astro';
import { effectReference } from '@domfx/site/effect-reference';
import { effects, type Effect } from '@domfx/site/effects';
import { localeFromPath } from '@domfx/site/locale';
import { effectReferenceEs } from '../../../content/effect-reference-es';
import { docsMessages } from '../../../content/docs-messages';
import { codeTheme } from '../../../content/examples';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { repositoryUrl } from '@domfx/site/site-links';

export function getStaticPaths() {
  return effects.map((effect) => ({ params: { effect: effect.id }, props: { effect } }));
}
interface Props { effect: Effect; }
const { effect } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const isEs = locale === 'es';
const reference = isEs ? effectReferenceEs[effect.id] : effectReference[effect.id];
const category = docsMessages(locale).categories[effect.category];
const docsPrefix = isEs ? '/docs/es' : '/docs';
const related = effects.filter((entry) => entry.category === effect.category && entry.id !== effect.id);
const optionsType = effect.category === 'Pattern' && effect.id !== 'dither'
  ? 'PatternOptions'
  : `${effect.exportName.slice('attach'.length)}Options`;
const code = `import { ${effect.exportName} } from '@domfx/browser';
import type { ${optionsType} } from '@domfx/browser';

// ${isEs ? 'Ejecuta después del montaje; host contiene target y tiene position: relative.' : 'Run after mount; host contains target and has position: relative.'}
const options: ${optionsType} = {
  host, clock: 'auto', intensity: 0.8,${effect.id === 'fire' ? '\n  flameHeight: 32,' : ''}
};
const effect = ${effect.exportName}(target, options);
// ${isEs ? 'Llama también a effect.dispose() al desmontar el componente.' : 'Also call effect.dispose() on component unmount.'}
window.addEventListener('pagehide', () => effect.dispose(), { once: true });
await effect.ready;
if (effect.lifecycle !== 'active') {
  console.info(effect.reason, effect.reasonDetail);
}`;
---
<StarlightPage
  frontmatter={{ title: effect.name, description: reference.description, editUrl: `${repositoryUrl}/edit/main/apps/docs/src/pages/api/effects/%5Beffect%5D.astro` }}
  headings={[
    { depth: 2, slug: 'usage', text: isEs ? 'Uso' : 'Usage' },
    { depth: 2, slug: 'effect-options', text: isEs ? 'Opciones del efecto' : 'Effect options' },
    { depth: 2, slug: 'shared-options', text: isEs ? 'Opciones compartidas' : 'Shared options' },
    { depth: 2, slug: 'controls', text: isEs ? 'Controles' : 'Controls' },
    { depth: 2, slug: 'limits', text: isEs ? 'Límites' : 'Limits' },
    { depth: 2, slug: 'related', text: isEs ? `Más efectos de ${category.toLowerCase()}` : `More ${effect.category.toLowerCase()} effects` },
  ]}
>
  <DocsEffectLab effect={effect} />
  <dl class="docs-effect-facts not-content">
    <div><dt>{isEs ? 'Categoría' : 'Category'}</dt><dd><a href={`${docsPrefix}/api/effects#${effect.category.toLowerCase()}`}>{category}</a></dd></div>
    <div><dt>{isEs ? 'Función' : 'Function'}</dt><dd><code>{effect.exportName}</code></dd></div>
    <div><dt>{isEs ? 'Opciones' : 'Options'}</dt><dd><code>{optionsType}</code></dd></div>
    <div><dt>{isEs ? 'Paquete' : 'Package'}</dt><dd><code>@domfx/browser</code></dd></div>
  </dl>
  <h2 id="usage">{isEs ? 'Uso' : 'Usage'}</h2>
  <p><code>{`${effect.exportName}(target: Element, options: ${optionsType}): EffectHandle`}</code></p>
  <p>{isEs ? 'Devuelve una instancia de efecto de inmediato. Las importaciones son seguras durante el renderizado en servidor; llama a la función en el navegador después de montar los elementos. La' : 'Returns an effect instance immediately. Imports are safe during server rendering; call the function in the browser after the elements are mounted. The'} <a href={`${docsPrefix}/standalone`}>{isEs ? 'guía de uso independiente' : 'Standalone guide'}</a> {isEs ? 'incluye el HTML y CSS necesarios.' : 'includes the required HTML and CSS.'}</p>
  <div class="docs-code-scroll" tabindex="0" role="region" aria-label={isEs ? `Uso de ${effect.name}` : `${effect.name} usage`}><Code code={code} lang="ts" theme={codeTheme} /></div>
  <h2 id="effect-options">{isEs ? 'Opciones del efecto' : 'Effect options'}</h2>
  {effect.id === 'fire' ? <>
    <p><code>FireOptions</code> {isEs ? 'amplía' : 'extends'} <code>AttachmentOptions</code> {isEs ? 'con la siguiente opción de creación.' : 'with the following creation option.'}</p>
    <DocsApiTable label={isEs ? 'Opciones de creación específicas de Fire' : 'Fire-specific creation options'}>
      <thead><tr><th scope="col">{isEs ? 'Propiedad' : 'Property'}</th><th scope="col">{isEs ? 'Tipo' : 'Type'}</th><th scope="col">{isEs ? 'Predeterminado' : 'Default'}</th></tr></thead>
      <tbody><tr><th scope="row"><code>flameHeight</code><p>{isEs ? 'Escala de las llamas en píxeles CSS del sistema de coordenadas del elemento objetivo, de 8 a 64. Es una escala artística, no una extensión máxima garantizada en píxeles. Se fija al crear el efecto; cambiarla requiere otra instancia.' : 'Flame scale in target-local CSS pixels, from 8 to 64. This is an artistic scale, not a guaranteed maximum pixel extent. Set at creation; changing it requires a new effect instance.'}</p></th><td><code>number</code></td><td><code>24</code></td></tr></tbody>
    </DocsApiTable>
  </> : <p><code>{optionsType}</code> {isEs ? 'acepta actualmente solo las opciones de creación compartidas que aparecen abajo. Este efecto no tiene ajustes públicos adicionales.' : 'currently accepts only the shared creation options below. This effect has no additional public settings.'}</p>}
  <h2 id="shared-options">{isEs ? 'Opciones compartidas' : 'Shared options'}</h2>
  <DocsSharedOptions />
  <h2 id="controls">{isEs ? 'Controles' : 'Controls'}</h2>
  <p>{reference.intensity}</p>
  <DocsEffectControls />
  <p>{isEs ? 'Consulta la sección sobre' : 'See'} <a href={`${docsPrefix}/api/shared#animation-control`}>{isEs ? 'animación automática y control externo' : 'automatic animation and external control'}</a> {isEs ? 'y la' : 'and the'} <a href={`${docsPrefix}/gsap`}>{isEs ? 'guía de GSAP' : 'GSAP guide'}</a>. {isEs ? 'La' : 'The'} <a href={`${docsPrefix}/api/effect-handle`}>{isEs ? 'referencia de la instancia de efecto' : 'effect instance reference'}</a> {isEs ? 'documenta el estado, las actualizaciones de captura y la liberación de recursos.' : 'documents state, capture updates and cleanup.'}</p>
  <h2 id="limits">{isEs ? 'Límites' : 'Limits'}</h2>
  <p>{isEs ? 'El efecto sigue la forma visible capturada, incluidos los huecos y las regiones separadas. Una imagen opaca tiene una forma rectangular. El contenido original permanece intacto; esta es una capa decorativa, no un cambio en la imagen o el texto de origen.' : 'The effect follows the captured visible shape, including holes and disconnected regions. An opaque image has a rectangular shape. The original content remains intact; this is a decorative layer, not a change to the source image or text.'}</p>
  <p>{isEs ? 'Los colores, los degradados, la cantidad de partículas y el procesamiento del elemento completo no son controles públicos. Solo se admiten las opciones aquí enumeradas. Se aplican límites de WebGPU, captura y composición; mantén utilizable el contenido original cuando la salida no esté disponible. Consulta' : 'Colors, gradients, particle counts and whole-element processing are not public controls. Only the options listed here are supported. WebGPU, capture and composition limits apply; keep the original content usable when output is unavailable. See'} <a href={`${docsPrefix}/support`}>{isEs ? 'compatibilidad con navegadores' : 'browser support'}</a> {isEs ? 'y' : 'and'} <a href={`${docsPrefix}/troubleshooting`}>{isEs ? 'solución de problemas' : 'troubleshooting'}</a>.</p>
  <h2 id="related">{isEs ? `Más efectos de ${category.toLowerCase()}` : `More ${effect.category.toLowerCase()} effects`}</h2>
  <DocsEffectLinks effects={related} />
  <p>{isEs ? 'Compara todos los efectos en la' : 'Compare every effect side by side in the'} <a href={`${isEs ? '/es' : ''}/effects/#${effect.id}`}>{isEs ? 'galería' : 'gallery'}</a>{isEs ? ', uno junto a otro.' : '.'}</p>
</StarlightPage>
