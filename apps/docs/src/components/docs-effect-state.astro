---
import { localeFromPath } from '@domfx/site/locale';

import DocsApiTable from './DocsApiTable.astro';

const isEs = localeFromPath(Astro.url.pathname) === 'es';
---
<p>{isEs ? 'Estas propiedades son de solo lectura. Un efecto pausado puede conservar una salida visible y actualizada. Consulta por separado el ciclo de vida, la captura y la pausa.' : 'These properties are read-only. A paused effect can still have up-to-date, visible output. Check lifecycle, capture status and pause separately.'}</p>
<DocsApiTable label={isEs ? 'Estado del efecto de solo lectura' : 'Read-only effect state'}>
  <thead><tr><th scope="col">{isEs ? 'Propiedad' : 'Property'}</th><th scope="col">{isEs ? 'Tipo' : 'Type'}</th></tr></thead>
  <tbody>
    <tr><th scope="row"><code>ready</code><p>{isEs ? 'Se resuelve después de la configuración inicial o la limpieza de una configuración cancelada. La indisponibilidad del entorno no la rechaza. Consulta lifecycle y reason al terminar.' : 'Resolves after initial setup or cleanup of cancelled setup. Environmental unavailability does not reject it. Check lifecycle and reason afterward.'}</p></th><td><code>Promise&lt;void&gt;</code></td></tr>
    <tr><th scope="row"><code>lifecycle</code><p>{isEs ? 'Estado actual del efecto. Consúltalo después de configurar o reintentar.' : 'Current effect state. Check it after setup or retry.'}</p></th><td><code>'active' | 'suspended' | 'unavailable' | 'disposed'</code></td></tr>
    <tr><th scope="row"><code>raster</code><p>{isEs ? 'Estado de captura: fresh está actualizado; refreshing indica una captura en curso; stale está desactualizado.' : 'Capture status: fresh is up to date; refreshing means capture is in progress; stale is out of date.'}</p></th><td><code>'fresh' | 'refreshing' | 'stale'</code></td></tr>
    <tr><th scope="row"><code>reason</code><p>{isEs ? 'Código del motivo de una salida no disponible o suspensión temporal. Úsalo para la lógica del programa.' : 'Reason code for unavailable output or temporary suspension. Use this for program logic.'}</p></th><td><code>EffectReason | undefined</code></td></tr>
    <tr><th scope="row"><code>reasonDetail</code><p>{isEs ? 'Mensaje de diagnóstico. Su redacción puede cambiar; no lo uses para la lógica del programa.' : 'Diagnostic message. Wording can change; do not use it for program logic.'}</p></th><td><code>string | undefined</code></td></tr>
    <tr><th scope="row"><code>clock</code><p>{isEs ? 'Control de animación elegido al crear el efecto.' : 'Animation control selected at creation.'}</p></th><td><code>'manual' | 'auto' | 'ambient'</code></td></tr>
    <tr><th scope="row"><code>seed</code><p>{isEs ? 'Semilla elegida al crear el efecto.' : 'Seed selected at creation.'}</p></th><td><code>number</code></td></tr>
    <tr><th scope="row"><code>paused</code><p>{isEs ? 'Indica si la animación automática de domfx está pausada. Siempre es true con control externo o un efecto inmóvil, incluso cuando GSAP cambia el tiempo.' : 'Whether domfx automatic animation is paused. Always true with external control or a still effect, including when GSAP is changing time.'}</p></th><td><code>boolean</code></td></tr>
  </tbody>
</DocsApiTable>
<p class="docs-api-note">{isEs ? 'Que termine la configuración no garantiza una salida visible ni una ejecución GPU terminada. Inspecciona' : 'Readiness does not guarantee visible output or completed GPU execution. Inspect'} <code>lifecycle</code> {isEs ? 'y' : 'and'} <code>reason</code>{isEs ? '; mantén utilizable el contenido original cuando la decoración no esté disponible.' : '; keep the original content usable when decoration is unavailable.'}</p>
