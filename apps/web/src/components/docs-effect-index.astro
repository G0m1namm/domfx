---
import { effects } from '../content/effects';
import DocsApiTable from './DocsApiTable.astro';
---
<p>Import these functions from <code>@domfx/browser</code>. Open an effect's reference for its exact options. The <a href="/effects/">gallery</a> provides live previews.</p>
<DocsApiTable label="Attachment functions">
  <thead><tr><th scope="col">Effect</th><th scope="col">Function</th><th scope="col">Category</th></tr></thead>
  <tbody>{effects.map((effect) => <tr><th scope="row"><a href={`/docs/api/effects/${effect.id}`}>{effect.name}</a></th><td><code>{effect.exportName}</code></td><td>{effect.category}</td></tr>)}</tbody>
</DocsApiTable>
