---
import { browserInstallCommand } from '@domfx/site/published-versions';
import { Code } from 'astro:components';
import { localePath, type Locale } from '@domfx/site/locale';
import { codeTheme } from '../content/examples';
import { marketingFaq, marketingMessages } from '../content/marketing-copy';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = marketingMessages[locale];
const questions = marketingFaq[locale];
const docsPath = (slug: 'introduction' | 'standalone' | 'gsap' | 'api' | 'support') => localePath({ kind: 'docs', slug }, locale);
const standalone = `import { attachFire } from '@domfx/browser';

const fire = attachFire(target, {
  host,
  clock: 'auto',
  intensity: 0.8,
});

// ${locale === 'es' ? 'Al desmontar: fire.dispose();' : 'On unmount: fire.dispose();'}`;
const sequence = `// ${locale === 'es' ? "effect se creó con clock: 'manual'." : "effect was created with clock: 'manual'."}
// ${locale === 'es' ? 'Usa tu propia línea de tiempo de GSAP.' : 'Use the GSAP timeline you already own.'}
timeline.to(effect, {
  time: 4,
  intensity: 0.4,
  duration: 4,
  ease: 'none',
}, 'ignite');

// ${locale === 'es' ? 'Al desmontar: detén tus animaciones y libera el efecto.' : 'On unmount: kill your tweens and dispose the effect.'}`;
---
<div class="marketing-story setup-story wrap">
  <section class="story-section">
    <div class="story-heading"><h2>{m.setupTitle}<br/>{m.setupTitleEnd}</h2><p>{m.setupDescription}</p></div>
    <div class="setup-layout">
      <ol class="setup-steps">
        <li><h3>{m.installTitle}</h3><p>{m.installDescription}</p><button class="install story-install" data-copy={browserInstallCommand} aria-label={m.copyInstall}><code>{browserInstallCommand}</code><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-copy"/></svg></button></li>
        <li><h3>{m.attachTitle}</h3><p>{m.attachDescription}</p></li>
        <li><h3>{m.motionTitle}</h3><p>{m.motionDescription}</p><a class="story-link" href={docsPath('standalone')}>{m.firstEffect} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></li>
      </ol>
      <div class="story-code"><div class="code-heading"><span>{m.standalone}</span><span>TypeScript</span></div><Code code={standalone} lang="ts" theme={codeTheme}/><a href={docsPath('standalone')}>{m.fullExample} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></div>
    </div>
  </section>
  <section class="story-section motion-feature">
    <div class="story-heading"><h2 class="gsap-effect-heading" data-effect-host>{m.gsapTitle} <span class="gsap-effect-word" data-preview="fire">GSAP</span> {m.gsapTitleEnd}<br/>{m.gsapTitleNext}</h2><p>{m.gsapDescription}</p><a class="story-link" href={docsPath('gsap')}>{m.buildGsap} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></div>
    <div class="sequence-composition">
      <div class="sequence-score" role="img" aria-label={m.timelineAlt}>
        <div class="score-ruler"><span>0s</span><span>0.5s</span><span>2.5s</span><span>4.5s</span></div>
        <div class="score-row"><span>{m.entrance}</span><div><i class="score-entrance"></i></div></div>
        <div class="score-row"><span>Fire</span><div><i class="score-effect">ignite <span>{m.seconds} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></span></i></div></div>
        <div class="score-caption"><span>{m.oneTimeline}</span><code>timeline.addLabel('ignite', 0.5)</code></div>
      </div>
      <div class="story-code"><div class="code-heading"><span>{m.sequenceExcerpt}</span><span>GSAP</span></div><Code code={sequence} lang="ts" theme={codeTheme}/></div>
    </div>
    <dl class="motion-methods"><div><dt><code>play() / pause()</code></dt><dd>{m.playPauseDescription}</dd></div><div><dt><code>seek() / reverse()</code></dt><dd>{m.seekReverseDescription}</dd></div><div><dt><code>timeScale()</code></dt><dd>{m.timeScaleDescription}</dd></div></dl>
  </section>
  <section class="native-proof story-section">
    <div class="proof-stage" data-effect-host><a data-preview="dither" href={docsPath('introduction')}>{m.stillHtml}</a><span>{m.selectText}</span></div>
    <div class="story-copy"><h2>{m.htmlTitle}<br/>{m.htmlTitleEnd}</h2><p>{m.htmlDescription}</p><a class="story-link" href={docsPath('introduction')}>{m.howItWorks} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></div>
  </section>
<section class="story-section story-faq"><div><h2>{m.faqTitle}</h2></div><div class="faq-list">{questions.map(([question, answer, slug, label]) => { const href = slug === 'npm' ? 'https://www.npmjs.com/package/@domfx/browser' : docsPath(slug as 'standalone' | 'api' | 'support'); return <details><summary>{question}<svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-plus"/></svg></summary><p>{answer}</p><a class="story-link" href={href}>{label} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href={slug === 'npm' ? '#ph-arrow-up-right' : '#ph-arrow-right'}/></svg></a></details>; })}</div></section>
</div>
