{
  "name": "domfx-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "GPU edge effects for live DOM elements.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/G0m1namm/domfx.git"
  },
  "type": "module",
  "scripts": {
    "agent:brief": "node scripts/agent-harness.mjs brief",
    "agent:verify": "node scripts/agent-harness.mjs verify",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:artifacts": "node scripts/check-release-artifacts.mjs",
    "release:rehearse": "pnpm build && node scripts/rehearse-release.mjs",
    "release:verify:registry": "node scripts/rehearse-release.mjs --registry",
    "release:check": "pnpm check && pnpm build:demo && pnpm release:status && pnpm release:artifacts",
    "build": "pnpm --filter \"./packages/**\" -r build",
    "build:demo": "pnpm build && pnpm --filter @domfx/lab build",
    "preview:demo": "pnpm --filter @domfx/lab preview",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm lint:boundaries && pnpm test:tooling && node scripts/test-packed-contracts.mjs && pnpm -r typecheck && pnpm -r test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "test": "pnpm build && pnpm -r test",
    "test:packed": "pnpm build && node scripts/test-packed-consumer.mjs",
    "test:packed:contracts": "pnpm build && node scripts/test-packed-contracts.mjs",
    "demo": "pnpm build && pnpm --filter @domfx/lab dev",
    "lint:boundaries": "node scripts/check-workspaces.mjs && depcruise --config dependency-cruiser.config.mjs packages apps",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:browser": "pnpm build:demo && pnpm test:browser:built",
    "test:browser:built": "pnpm --filter @domfx/lab test:browser",
    "hooks:install": "lefthook install",
    "prepare": "lefthook install",
    "measure:steady": "node apps/lab/scripts/measure-performance.mjs --steady",
    "measure:layout": "node apps/lab/scripts/measure-layout.mjs",
    "measure:performance": "node apps/lab/scripts/measure-performance.mjs",
    "test:browser:evidence": "node apps/lab/scripts/browser-regression.mjs",
    "web": "pnpm build && pnpm --filter @domfx/web dev",
    "build:web": "pnpm build && pnpm --filter @domfx/web build",
    "preview:web": "pnpm --filter @domfx/web preview",
    "test:web": "pnpm build:web && pnpm --filter @domfx/web test:browser",
    "test:browser:smoke": "pnpm build:demo && pnpm test:browser:smoke:built",
    "test:browser:smoke:built": "pnpm --filter @domfx/lab exec playwright test --project production --grep @smoke",
    "build:demo:built": "pnpm --filter @domfx/lab build"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "dependency-cruiser": "18.2.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.5.0"
}
