---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import { localeFromPath, localePath } from '@domfx/site/locale';

import { docsMessages } from '../content/docs-messages';

const locale = localeFromPath(Astro.url.pathname);
const messages = docsMessages(locale);
---
<DefaultSidebar />
<p class="docs-sidebar-note">{messages.experimental}</p>
<a class="text-link" href={localePath({ kind: 'docs', slug: 'installation' }, locale)}>{messages.installationOptions}</a>
<a class="text-link" href={localePath({ kind: 'effects' }, locale)}>{messages.liveExamples}</a>
