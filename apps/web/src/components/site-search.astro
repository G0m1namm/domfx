---
import { effects } from '@domfx/site/effects';
import '@domfx/site/styles/site-search.css';
---
<dialog id="site-search" class="site-search-dialog" aria-labelledby="site-search-title" data-docs-pagefind="/docs/pagefind/pagefind.js">
  <div class="site-search-heading"><h2 id="site-search-title">Search domfx</h2><button data-search-close aria-label="Close search"><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-x"/></svg></button></div>
  <label class="site-search-field"><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-magnifying-glass"/></svg><input type="search" data-global-search aria-label="Search effects and documentation" placeholder="Try frost, GSAP, or reduced motion" aria-controls="site-search-results" autocomplete="off" autofocus/></label>
  <p class="site-search-status" role="status" aria-live="polite">Effects and documentation</p>
  <div id="site-search-results" class="site-search-results">
    <section data-search-group="effects" aria-labelledby="search-effects-heading">
      <h3 id="search-effects-heading">Effects</h3>
      <ul>{effects.map(({id, name, category}, index) => {
        const label = <><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-sparkle"/></svg><span><strong>{name}</strong><small>{category}</small></span><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></>;
        return <li data-search-item data-search-kind="effects" data-title={name.toLowerCase()} data-keywords={`${name} ${category} effect`.toLowerCase()} data-starter={index < 4 ? 'true' : undefined}><button data-search-effect={id} data-id={id} data-name={name} data-category={category}>{label}</button></li>;
      })}</ul>
    </section>
    <section data-search-group="documentation" aria-labelledby="search-docs-heading">
      <h3 id="search-docs-heading">Documentation</h3>
      <ul></ul>
    </section>
  </div>
  <p class="site-search-empty" hidden>No matches. Try an effect name or a documentation topic.</p>
  <div class="site-search-hint"><span>↑ ↓ to move · Enter to open</span><span>Esc to close</span></div>
</dialog>
