---
import { footerLinkGroups, repositoryUrl } from '@domfx/site/site-links';

const year = new Date().getFullYear();
---
<footer class="docs-site-footer">
  <div class="docs-site-footer-navigation">
    <div class="docs-site-footer-intro">
      <a class="docs-site-footer-wordmark" href="/">domfx<img class="brand-mark" src="/brand-mark.svg" width="30" height="30" alt="" aria-hidden="true" /></a>
      <p>Effects for your HTML.</p>
    </div>
    {footerLinkGroups.map((group) => <nav aria-label={`Footer ${group.title}`}><h2>{group.title}</h2>{group.items.map(([label, href]) => <a href={href}>{label}{href.startsWith('https://') && <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-up-right"/></svg>}</a>)}</nav>)}
  </div>
  <div class="docs-site-footer-baseline">
    <span>© {year} domfx · <a href={`${repositoryUrl}/blob/main/LICENSE`}>MIT licensed</a></span>
    <span>Made by <a href="https://github.com/G0m1namm">Jherson Martelo Medina</a></span>
  </div>
</footer>
