---
import ZoomChip from '@domfx/site/components/zoom-chip.astro';
import { localeFromPath } from '@domfx/site/locale';

import { docsMessages } from '../content/docs-messages';

interface Props {
  id: string;
}
const { id } = Astro.props;
const messages = docsMessages(localeFromPath(Astro.url.pathname)).preview;
---

<div class="docs-lab-stage" data-docs-preview tabindex="0" role="region" aria-label={messages.region} aria-describedby={`${id}-zoom-help`}>
  <slot />
</div>
<ZoomChip helpId={`${id}-zoom-help`} labels={messages}><span class="docs-preview-hover-hint">{messages.hover}</span><span class="docs-preview-touch-hint">{messages.inspect}</span> {messages.keys}</ZoomChip>
