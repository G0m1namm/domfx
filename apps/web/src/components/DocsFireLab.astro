---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="docs-fire-lab" data-docs-fire-lab aria-labelledby="docs-fire-lab-title">
  <div class="docs-fire-lab-heading">
    <div>
      <h3 id="docs-fire-lab-title">{title}</h3>
    </div>
    <p>{description}</p>
  </div>
  <div class="docs-fire-lab-stage" data-docs-fire-host>
    <span class="docs-fire-lab-target" data-docs-fire-target>domfx</span>
  </div>
  <div class="docs-fire-lab-controls">
    <label>
      <span>Intensity <output data-docs-intensity-output>80%</output></span>
      <input
        data-docs-intensity
        type="range"
        min="0"
        max="100"
        value="80"
        aria-label="Fire intensity"
      />
    </label>
    <label>
      <span>Flame height <output data-docs-height-output>32px</output></span>
      <input
        data-docs-height
        type="range"
        min="8"
        max="64"
        step="1"
        value="32"
        aria-label="Fire flame height"
      />
    </label>
  </div>
  <div class="docs-fire-lab-footer">
    <p data-docs-fire-status aria-live="polite">Waiting to enter view.</p>
    <button type="button" class="docs-fire-lab-button" data-docs-fire-toggle aria-pressed="false">
      Pause effect
    </button>
  </div>
  <pre class="docs-fire-lab-code" aria-label="Live Fire settings"><code>const fire = attachFire(target, &#123;
  host, clock: 'ambient', motion: 'respect',
  intensity: <output data-docs-intensity-code>0.8</output>, flameHeight: <output data-docs-height-code>32</output>, seed: 314,
&#125;);</code></pre>
</section>
