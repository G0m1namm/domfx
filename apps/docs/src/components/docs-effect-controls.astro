---
import { localeFromPath } from '@domfx/site/locale';

import DocsApiTable from './DocsApiTable.astro';

const isEs = localeFromPath(Astro.url.pathname) === 'es';
---
<p>{isEs ? 'Lee y modifica estas propiedades de la instancia de efecto. Los cambios pueden leerse de inmediato. Cuando la salida está disponible, se dibujan en el siguiente fotograma sin volver a capturar el elemento.' : 'Read and write these properties on the effect instance. Writes are immediately readable. When output is available, they render on the next frame without recapturing the target.'}</p>
<DocsApiTable label={isEs ? 'Controles modificables del efecto' : 'Writable effect controls'}>
  <thead><tr><th scope="col">{isEs ? 'Propiedad' : 'Property'}</th><th scope="col">{isEs ? 'Tipo' : 'Type'}</th></tr></thead>
  <tbody>
    <tr><th scope="row"><code>time</code><p>{isEs ? 'Tiempo del efecto en segundos. Permite avanzar y retroceder, incluso a tiempos negativos.' : 'Effect time in seconds. Supports forward and backward seeking, including negative time.'}</p></th><td><code>number</code></td></tr>
    <tr><th scope="row"><code>intensity</code><p>{isEs ? 'Intensidad del efecto, limitada al intervalo de 0 a 1 después de validar el valor. No es un ajuste universal de altura ni de opacidad.' : 'Effect strength, clamped to 0–1 after validation. It is not a universal height or opacity setting.'}</p></th><td><code>number</code></td></tr>
  </tbody>
</DocsApiTable>
<p>{isEs ? 'Ambos valores deben ser finitos y representables como float32. Usa un solo controlador por propiedad: asignaciones directas, una línea de tiempo u otro controlador de animación.' : 'Both values must be finite and representable as float32. Use one writer per property: direct assignments, a timeline or another animation driver.'}</p>
