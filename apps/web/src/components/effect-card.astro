---
import openRing from '../assets/brand/open-ring.png';
import split from '../assets/brand/split.png';
import washer from '../assets/brand/washer.png';
import { effectDescriptions, type Effect } from '@domfx/site/effects';
import type { Locale } from '@domfx/site/locale';
import { marketingMessages } from '../content/marketing-copy';
interface Props { effect: Effect; index: number; locale: Locale }
const { effect, index, locale } = Astro.props;
const { id, name, category } = effect;
const m = marketingMessages[locale];
const categoryLabel = category === 'Energy' ? m.energy : category === 'Material' ? m.material : m.patternCategory;
const description = effectDescriptions[locale][id];
const sample = index % 5;
const image = id === 'fire' ? split : id === 'slime' ? openRing : sample === 0 ? washer : undefined;
---
<button class="effect-card" id={id} data-card data-id={id} data-name={name} data-category={category} aria-label={`${m.tryEffect} ${name}`}>
  <div class="card-art" data-effect-host style={`--card-index:${index}`}>
    {image ? <img class="effect-subject ring brand-illustration" data-preview={id} src={image.src} width="240" height="180" alt="" /> : sample === 1 ? <span class="effect-subject letter" data-preview={id}>Aa</span> : sample === 2 ? <svg class="effect-subject symbol" data-preview={id} width="130" height="130" viewBox="0 0 160 160" aria-hidden="true"><path fill="#C2C5DB" d="M64 8H96V45L122 19L145 42L119 68H156V100H119L145 126L122 149L96 123V160H64V123L38 149L15 126L41 100H4V68H41L15 42L38 19L64 45Z"/></svg> : sample === 3 ? <span class="effect-subject word" data-preview={id}>flow.</span> : <svg class="effect-subject symbol" data-preview={id} width="150" height="150" viewBox="0 0 160 160" aria-hidden="true"><path fill="#C2C5DB" fill-rule="evenodd" d="M80 8A72 72 0 1 1 79.99 8ZM80 44A36 36 0 1 0 80.01 44Z"/><path fill="#E8EAF3" d="M73 0H87V160H73Z"/></svg>}
  </div>
  <div class="card-info"><h3>{name}</h3><p>{description}</p><div class="card-meta"><span class="category">{categoryLabel}</span></div></div>
  <span class="card-open"><span>{m.preview}</span><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></span>
</button>
