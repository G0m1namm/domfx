---
import { documentation } from '../content/documentation';

const groups = [...new Set(documentation.map((page) => page.group))];
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---
<nav aria-label="Documentation">
  {groups.map((group) => <div class="docs-nav-group">
    <h2>{group}</h2>
    {documentation.filter((page) => page.group === group).map((page) =>
      <a href={`/docs/${page.slug}`} aria-current={currentPath === `/docs/${page.slug}` ? 'page' : undefined}>{page.title}</a>
    )}
  </div>)}
</nav>
