---
import { Code } from 'astro:components';
import { codeTheme } from '../content/examples';
const standalone = `import { attachFire } from '@domfx/browser';

const fire = attachFire(target, {
  host,
  clock: 'ambient',
  intensity: 0.8,
});

// On unmount: fire.dispose();`;
const sequence = `import { bindFire } from '@domfx/gsap';

// fire is a manual-clock attachment.
const binding = bindFire(fire, timeline, {
  time: 4,
  intensity: 0.4,
  duration: 4,
  position: 'ignite',
});`;
const questions = [
  ['Do I need GSAP?', 'No. An ambient clock animates the effect on its own. Add the optional GSAP binding when you want to sequence time and intensity.', '/docs/standalone', 'Standalone guide'],
  ['Do I need a particular framework?', 'The browser API takes a DOM element. Attach after mount and dispose on unmount in the framework you use.', '/docs/api', 'Explore the API'],
  ['What happens without WebGPU?', 'The original HTML stays available. Effects require WebGPU and supported capture conditions; reduced motion suppresses animated output by default.', '/docs/support', 'Check browser support'],
  ['How do I install it?', 'Install @domfx/browser from npm. For timeline control, add @domfx/gsap and gsap to your project too.', 'https://www.npmjs.com/package/@domfx/browser', 'View the package on npm'],
];
---
<div class="marketing-story setup-story wrap">
  <section class="story-section">
    <div class="story-heading"><h2>From the gallery<br/>to your page.</h2><p>Install domfx, choose an element and add your first effect.</p></div>
    <div class="setup-layout">
      <ol class="setup-steps">
        <li><h3>Install domfx.</h3><p>Add the browser package to your project.</p><button class="install story-install" data-copy="pnpm add @domfx/browser" aria-label="Copy install command"><code>pnpm add @domfx/browser</code><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-copy"/></svg></button></li>
        <li><h3>Attach the effect.</h3><p>Choose text, an inline SVG or an image. Attach an effect to follow its visible shape.</p></li>
        <li><h3>Choose how it moves.</h3><p>Let it animate on its own, or control its time and intensity with GSAP.</p><a class="story-link" href="/docs/standalone">Attach your first effect <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></li>
      </ol>
      <div class="story-code"><div class="code-heading"><span>Standalone</span><span>TypeScript</span></div><Code code={standalone} lang="ts" theme={codeTheme}/><a href="/docs/standalone">See the full example <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></div>
    </div>
  </section>
  <section class="story-section motion-feature">
    <div class="story-heading"><h2 class="gsap-effect-heading" data-effect-host>Your <span class="gsap-effect-word" data-preview="fire">GSAP</span> timeline.<br/>A new layer.</h2><p>Sequence effects alongside your existing animation. Control their time and intensity with the GSAP timeline you already use.</p><a class="story-link" href="/docs/gsap">Build with GSAP <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></div>
    <div class="sequence-composition">
      <div class="sequence-score" role="img" aria-label="Illustrative timeline: entrance from zero to half a second, then Fire from half a second to four and a half seconds.">
        <div class="score-ruler"><span>0s</span><span>0.5s</span><span>2.5s</span><span>4.5s</span></div>
        <div class="score-row"><span>Entrance</span><div><i class="score-entrance"></i></div></div>
        <div class="score-row"><span>Fire</span><div><i class="score-effect">ignite <span>4 seconds <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></span></i></div></div>
        <div class="score-caption"><span>One timeline. Both layers.</span><code>timeline.addLabel('ignite', 0.5)</code></div>
      </div>
      <div class="story-code"><div class="code-heading"><span>Sequence excerpt</span><span>@domfx/gsap</span></div><Code code={sequence} lang="ts" theme={codeTheme}/></div>
    </div>
    <dl class="motion-methods"><div><dt><code>play() / pause()</code></dt><dd>Run the sequence or hold a moment.</dd></div><div><dt><code>seek() / reverse()</code></dt><dd>Move through the effect in either direction.</dd></div><div><dt><code>timeScale()</code></dt><dd>Set the pace with the controls you know.</dd></div></dl>
  </section>
  <section class="native-proof story-section">
    <div class="proof-stage" data-effect-host><a data-preview="dither" href="/docs/introduction">Still HTML.</a><span>Select the text. Follow the link.</span></div>
    <div class="story-copy"><h2>Your HTML stays<br/>interactive.</h2><p>Text stays selectable. Links keep working. domfx adds a decorative layer alongside your element, leaving the original HTML in place.</p><a class="story-link" href="/docs/introduction">How domfx works <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></div>
  </section>
<section class="story-section story-faq"><div><h2>Before you build.</h2></div><div class="faq-list">{questions.map(([question, answer, href, label]) => <details><summary>{question}<svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-plus"/></svg></summary><p>{answer}</p><a class="story-link" href={href}>{label} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href={href.startsWith('https://') ? '#ph-arrow-up-right' : '#ph-arrow-right'}/></svg></a></details>)}</div></section>
</div>
