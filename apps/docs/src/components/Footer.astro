---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';

import { repositoryUrl } from '@domfx/site/site-links';

import DocsFooter from './DocsFooter.astro';

const { entry } = Astro.locals.starlightRoute;
const issue = new URL(`${repositoryUrl}/issues/new`);
issue.searchParams.set('title', `Docs: ${entry.data.title}`);
issue.searchParams.set('body', `Page: ${Astro.url.pathname}\n\nWhat needs to change?\n`);
---
<nav class="docs-page-actions" aria-label="Page feedback">
  <EditLink />
  <a href={issue.href}><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-bug"/></svg>Report an issue</a>
</nav>
<Pagination />
<DocsFooter />
