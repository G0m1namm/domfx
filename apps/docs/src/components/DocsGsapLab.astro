---
import '@domfx/site/styles/effect-controls.css';
import { Code } from 'astro:components';
import { localeFromPath } from '@domfx/site/locale';

import { docsMessages } from '../content/docs-messages';
import { codeTheme, gsapIgnitionCode } from '../content/examples';
import DocsPreview from './DocsPreview.astro';

const messages = docsMessages(localeFromPath(Astro.url.pathname)).gsapLab;
const id = 'docs-gsap';
const letters = [...'domfx'];
const acts = [
  ['arrive', 0],
  ['ignite', 1],
  ['surge', 2.4],
  ['burnOut', 4.2],
] as const;
---

<section class="docs-lab docs-gsap-lab not-content" data-docs-gsap-lab data-effect="fire" data-status="suspended" data-status-visible="true" data-paused="true" aria-labelledby={`${id}-title`}>
  <div class="docs-lab-heading">
    <h3 id={`${id}-title`}>{messages.title}</h3>
    <p>{messages.introduction}</p>
  </div>
  <div class="docs-lab-frame">
    <DocsPreview id={id}>
      <div class="docs-lab-host" data-gsap-host data-docs-preview-camera>
        <p class="docs-gsap-word" data-gsap-word><span class="visually-hidden">domfx</span>{letters.map((letter) => <span class="docs-gsap-letter" data-gsap-letter aria-hidden="true">{letter}</span>)}</p>
      </div>
    </DocsPreview>
    <p class="docs-lab-status" role="status"><span class="docs-lab-dot" aria-hidden="true"></span><span data-gsap-status>{messages.needsGpu}</span></p>
    <div class="control-box">
      <div class="control-box-anchor" data-box-anchor data-open="details">
        <div class="control-box-dock docs-gsap-dock">
          <div class="control-box-tabs">
            <button type="button" class="control-box-tab" data-gsap-details aria-expanded="true" aria-controls={`${id}-details`} disabled>{messages.details}</button>
          </div>
          <!-- Open without JavaScript too: the tracks and starting values stay readable. -->
          <div class="control-box-panel" id={`${id}-details`} data-box-panel>
            <div class="control-box-view docs-gsap-details">
              <div class="docs-gsap-acts" role="group" aria-label={messages.controls}>
                {acts.map(([act, start]) => <button type="button" data-gsap-act={start} aria-current="false" disabled>{messages.acts[act]}</button>)}
              </div>
              <dl class="docs-gsap-values">
                <div><dt>time (s)</dt><dd><output data-gsap-time-output aria-live="off">0.00</output></dd></div>
                <div><dt>rootColor</dt><dd><i class="docs-gsap-swatch" data-gsap-root-color style="background:#fff5a3"></i></dd></div>
                <div class="docs-gsap-meters">
                  <dt>intensity</dt>
                  <dd>{letters.map((letter) => <span class="docs-gsap-meter" style="--level:0"><span aria-hidden="true">{letter}</span><output data-gsap-intensity-output aria-live="off">0.00</output></span>)}</dd>
                </div>
              </dl>
            </div>
          </div>
          <div class="effect-setting docs-gsap-position">
            <label class="control-box-sr" for={`${id}-position`}>{messages.position}</label>
            <input id={`${id}-position`} type="range" min="0" max="6" step="0.01" value="0" style="--fill:0%" data-gsap-position aria-describedby={`${id}-help`} disabled />
            <output for={`${id}-position`} data-gsap-position-output aria-live="off">0.00</output>
            <p class="control-box-sr" id={`${id}-help`}>{messages.help}</p>
          </div>
          <div class="control-box-actions" role="group" aria-label={messages.controls}>
            <button type="button" class="control-box-action" data-gsap-play data-tip aria-label={messages.play} disabled><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-play"/></svg></button>
            <button type="button" class="control-box-action" data-gsap-restart data-tip aria-label={messages.restart} disabled><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-counter-clockwise"/></svg></button>
            <button type="button" class="control-box-action docs-gsap-reverse" data-gsap-reverse data-tip aria-label={messages.reverse} disabled><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-play"/></svg></button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="docs-lab-code docs-gsap-code">
    <div class="docs-lab-code-bar">{messages.source}</div>
    <div class="docs-code-scroll" tabindex="0" role="region" aria-label={messages.source}><Code code={gsapIgnitionCode} lang="ts" theme={codeTheme} /></div>
  </div>
  <p class="docs-gsap-source-note">{messages.sourceNote}</p>
</section>

<script>
  import '../scripts/docs-gsap-lab';
</script>
