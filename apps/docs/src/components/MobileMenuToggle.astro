---
import { localeFromPath } from '@domfx/site/locale';

import { docsMessages } from '../content/docs-messages';

const { title } = Astro.locals.starlightRoute.entry.data;
const messages = docsMessages(localeFromPath(Astro.url.pathname));
---
<button popovertarget="starlight__sidebar" class="docs-menu-toggle md:sl-hidden print:hidden"><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-list"/></svg>{messages.docs}</button>

<span class="docs-mobile-title" aria-hidden="true">{title}</span>
