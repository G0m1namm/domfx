---
type Props = astroHTML.JSX.IntrinsicElements['select'];

const { class: className, ...attributes } = Astro.props;
---
<span class="select-control">
  <select {...attributes} class:list={['select-control-input', className]}><slot /></select>
  <svg class="select-control-icon" viewBox="0 0 256 256" aria-hidden="true" focusable="false"><use href="#ph-caret-down" /></svg>
</span>

<style>
  .select-control {
    display: grid;
    min-inline-size: 0;
  }
  .select-control-input {
    grid-area: 1 / 1;
    inline-size: 100%;
    min-inline-size: 0;
    min-block-size: max(2.75rem, 44px);
    margin: 0;
    padding-block: 0.625rem;
    padding-inline: 0.75rem 2.5rem;
    border: 1px solid #8e91a8;
    border-radius: 0.375rem;
    background: #1d1f27;
    color: #e8eaf3;
    color-scheme: dark;
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    appearance: none;
    cursor: pointer;
    transition: border-color 150ms ease-out, background-color 150ms ease-out;
  }
  .select-control-icon {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: end;
    inline-size: 1rem;
    block-size: 1rem;
    margin-inline-end: 0.75rem;
    fill: currentColor;
    color: #aeb1c1;
    pointer-events: none;
  }
  .select-control-input:hover:not(:disabled) {
    border-color: #c2c5db;
    background: #292a35;
  }
  .select-control-input:focus-visible {
    border-color: #e6dc6a;
    outline: 2px solid #e6dc6a;
    outline-offset: 2px;
  }
  .select-control-input:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .select-control-input:disabled + .select-control-icon {
    opacity: 0.6;
  }
  @media (prefers-reduced-motion: reduce) {
    .select-control-input {
      transition: none;
    }
  }
  @media (forced-colors: active) {
    .select-control-input {
      padding-inline-end: 0.75rem;
      appearance: auto;
    }
    .select-control-icon {
      display: none;
    }
  }
</style>
