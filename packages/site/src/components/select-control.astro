---
type Props = astroHTML.JSX.IntrinsicElements['select'];

const { class: className, ...attributes } = Astro.props;
---
<span class="select-control">
  <select {...attributes} class:list={['select-control-input', className]}><slot /></select>
  <svg class="select-control-icon" viewBox="0 0 256 256" aria-hidden="true" focusable="false"><use href="#ph-caret-down" /></svg>
</span>

<style>
  .select-control {
    display: grid;
    min-inline-size: 0;
  }
  .select-control-input {
    grid-area: 1 / 1;
    inline-size: 100%;
    min-inline-size: 0;
    min-block-size: max(2.75rem, 44px);
    margin: 0;
    padding-block: 0.625rem;
    padding-inline: 0.75rem 2.5rem;
    border: 1px solid #8e91a8;
    border-radius: 0.375rem;
    background: #1d1f27;
    color: #e8eaf3;
    color-scheme: dark;
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    appearance: none;
    cursor: pointer;
    transition: border-color 150ms ease-out, background-color 150ms ease-out;
  }
  .select-control-icon {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: end;
    inline-size: 1rem;
    block-size: 1rem;
    margin-inline-end: 0.75rem;
    fill: currentColor;
    color: #aeb1c1;
    pointer-events: none;
  }
  .select-control-input:hover:not(:disabled) {
    border-color: #c2c5db;
    background: #292a35;
  }
  .select-control-input:focus-visible {
    border-color: #e6dc6a;
    outline: 2px solid #e6dc6a;
    outline-offset: 2px;
  }
  .select-control-input:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .select-control-input:disabled + .select-control-icon {
    opacity: 0.6;
  }
  @media (prefers-reduced-motion: reduce) {
    .select-control-input {
      transition: none;
    }
  }
  /* Phones, forced colors and browsers without customizable select keep the native picker. */
  @media (hover: hover) and (pointer: fine) and (forced-colors: none) {
    @supports (appearance: base-select) {
      .select-control-input,
      .select-control-input::picker(select) {
        appearance: base-select;
      }
      .select-control-input {
        display: flex;
        align-items: center;
      }
      .select-control-input::picker-icon {
        display: none;
      }
      .select-control-input::picker(select) {
        margin-block: 0.25rem;
        padding: 0.25rem;
        border: 1px solid #454754;
        border-radius: 0.375rem;
        background: #1d1f27;
        color: #e8eaf3;
        opacity: 0;
        translate: 0 -0.25rem;
        transition:
          opacity var(--motion-exit-duration) var(--motion-exit-easing),
          translate var(--motion-exit-duration) var(--motion-exit-easing),
          overlay var(--motion-exit-duration) allow-discrete,
          display var(--motion-exit-duration) allow-discrete;
      }
      .select-control-input:open::picker(select) {
        opacity: 1;
        translate: none;
        transition:
          opacity var(--motion-swap-in-duration) ease-out,
          translate var(--motion-enter-duration) var(--motion-enter-easing),
          overlay var(--motion-exit-duration) allow-discrete,
          display var(--motion-exit-duration) allow-discrete;
      }
      @starting-style {
        .select-control-input:open::picker(select) {
          opacity: 0;
          translate: 0 -0.25rem;
        }
      }
      .select-control-input :global(option) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-block-size: max(2.75rem, 44px);
        padding-inline: 0.625rem;
        border-radius: 0.25rem;
        font-size: 0.8125rem;
      }
      .select-control-input :global(option:hover),
      .select-control-input :global(option:focus-visible) {
        background: #292a35;
      }
      .select-control-input :global(option:focus-visible) {
        outline: 2px solid #e6dc6a;
        outline-offset: -2px;
      }
      .select-control-input :global(option)::checkmark {
        order: 1;
      }
      .select-control-icon {
        transition: rotate var(--motion-exit-duration) var(--motion-exit-easing);
      }
      .select-control-input:open + .select-control-icon {
        rotate: 180deg;
        transition: rotate var(--motion-enter-duration) var(--motion-enter-easing);
      }
    }
  }
  @media (forced-colors: active) {
    .select-control-input {
      padding-inline-end: 0.75rem;
      appearance: auto;
    }
    .select-control-icon {
      display: none;
    }
  }
</style>
