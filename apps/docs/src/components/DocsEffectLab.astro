---
import piercedRing from '../assets/brand/pierced-ring.png';
import ControlBox from '@domfx/site/components/control-box.astro';
import { controlBoxMessages } from '@domfx/site/control-box-messages';
import { defaultEffectSettings, effectSnippet } from '@domfx/site/effect-settings';
import { effects, type Effect } from '@domfx/site/effects';
import { localeFromPath } from '@domfx/site/locale';

import { docsMessages } from '../content/docs-messages';
import DocsPreview from './DocsPreview.astro';

type Subject = 'text' | 'svg' | 'image';
interface Props {
  effect: Effect;
  subject?: Subject;
  heading?: string;
  description?: string;
}

// Match the gallery card subject so a reference opens on the shape visitors saw.
const gallerySubjects: Subject[] = ['image', 'text', 'svg', 'text', 'svg'];

const { effect, heading, description } = Astro.props;
const subject = Astro.props.subject ?? (effect.id === 'fire' || effect.id === 'slime' ? 'image' : gallerySubjects[effects.indexOf(effect) % gallerySubjects.length]);
const id = `docs-lab-${effect.id}`;
// Spread so SVG accepts the global hidden attribute, which its typings omit.
const visibility = (kind: Subject) => (kind === subject ? {} : { hidden: true });
const locale = localeFromPath(Astro.url.pathname);
const messages = docsMessages(locale).lab;
const label = locale === 'es' ? `${messages.livePreview} de ${effect.name}` : `${effect.name} ${messages.livePreview}`;
---

<section class="docs-lab not-content" data-docs-lab data-effect={effect.id} data-category={effect.category} data-status="suspended" data-status-visible="true" data-paused="false" aria-labelledby={heading ? `${id}-title` : undefined} aria-label={heading ? undefined : label}>
  {heading && <div class="docs-lab-heading"><h3 id={`${id}-title`}>{heading}</h3>{description && <p>{description}</p>}</div>}
  <div class="docs-lab-frame">
    <DocsPreview id={id}>
      <div class="docs-lab-host" data-docs-lab-host data-docs-preview-camera>
        <span class="docs-lab-subject docs-lab-text" data-docs-lab-target="text" {...visibility('text')}>domfx</span>
        <svg class="docs-lab-subject docs-lab-svg" data-docs-lab-target="svg" {...visibility('svg')} width="132" height="132" viewBox="0 0 160 160" aria-hidden="true"><path fill="#C2C5DB" d="M64 8H96V45L122 19L145 42L119 68H156V100H119L145 126L122 149L96 123V160H64V123L38 149L15 126L41 100H4V68H41L15 42L38 19L64 45Z"/></svg>
        <img class="docs-lab-subject docs-lab-image" data-docs-lab-target="image" {...visibility('image')} src={piercedRing.src} width="200" height="150" alt="" decoding="async" />
      </div>
    </DocsPreview>
    <p class="docs-lab-status" aria-live="polite"><span class="docs-lab-dot" aria-hidden="true"></span><span data-docs-lab-status>{messages.needsGpu}</span></p>
    <ControlBox effect={effect} locale={locale} id={id} target={subject} />
  </div>
  <noscript><pre class="docs-lab-static-code" tabindex="0" aria-label={controlBoxMessages(locale).code}><code>{effectSnippet(effect, defaultEffectSettings(effect), locale)}</code></pre></noscript>
</section>
