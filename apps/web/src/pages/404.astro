---
import '@domfx/site/styles/shared.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page not found · domfx</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href="/fonts/CabinetGrotesk-Medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main>
      <h1>Page not found</h1>
      <p>This page may have moved. <a class="text-link" href="/">Go to the homepage</a></p>
      <div lang="es">
        <h2>Página no encontrada</h2>
        <p>La página puede haber cambiado de dirección. <a class="text-link" href="/es/">Ir al inicio</a></p>
      </div>
    </main>
  </body>
</html>
<style>
  main {
    max-inline-size: 65ch;
    margin: clamp(3rem, 10vh, 8rem) auto;
    padding-inline: 1.5rem;
  }
</style>
