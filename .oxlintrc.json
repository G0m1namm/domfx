{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/consistent-type-imports": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.test-dist/**",
    "dist-demo/**",
    "docs/**",
    ".scratch/**",
    ".agents/**",
    "**/.pnpm-store/**"
  ]
}
