---
import { effects } from '@domfx/site/effects';
import { localeFromPath } from '@domfx/site/locale';
import DocsApiTable from './DocsApiTable.astro';

import { docsMessages } from '../content/docs-messages';

const locale = localeFromPath(Astro.url.pathname);
const categories = docsMessages(locale).categories;
---
<p>{locale === 'es' ? 'Importa estas funciones desde' : 'Import these functions from'} <code>@domfx/browser</code>. {locale === 'es' ? 'Cada referencia comienza con una vista previa interactiva, seguida de sus opciones exactas.' : 'Each reference opens with a live preview, followed by its exact options.'}</p>
<DocsApiTable label={locale === 'es' ? 'Funciones de efecto' : 'Attachment functions'}>
  <thead><tr><th scope="col">{locale === 'es' ? 'Efecto' : 'Effect'}</th><th scope="col">{locale === 'es' ? 'Función' : 'Function'}</th><th scope="col">{locale === 'es' ? 'Categoría' : 'Category'}</th></tr></thead>
  <tbody>{effects.map((effect) => <tr><th scope="row"><a href={`/docs/${locale === 'es' ? 'es/' : ''}api/effects/${effect.id}`}>{effect.name}</a></th><td><code>{effect.exportName}</code></td><td>{categories[effect.category]}</td></tr>)}</tbody>
</DocsApiTable>
