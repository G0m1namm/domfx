---
import { documentation } from '../content/documentation';
import { effects } from '../content/effects';
const sources = import.meta.glob('../pages/docs/*.{md,astro}', { query: '?raw', import: 'default', eager: true });
const plain = (source: string) => source.replace(/^---[\s\S]*?---/, '').replace(/<[^>]*>/g, ' ').replace(/[`*#]/g, '').replace(/\s+/g, ' ').trim();
const entries = documentation.flatMap((doc) => {
  const source = String(sources[`../pages/docs/${doc.slug}.md`] ?? sources[`../pages/docs/${doc.slug}.astro`] ?? '');
  const description = doc.slug === 'installation' ? 'Install domfx and the optional GSAP binding.' : doc.description;
  const sections = [...source.matchAll(/^## (.+)$|<h2 id="([^"]+)">(.*?)<\/h2>/gm)];
  return [{ title: doc.title, detail: description, href: `/docs/${doc.slug}`, keywords: `${doc.title} ${description} ${plain(source)}`, starter: true }, ...sections.map((section, index) => {
    const title = section[1] ?? section[3];
    const slug = section[2] ?? title.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-');
    const content = source.slice(section.index, sections[index + 1]?.index ?? source.length);
    return { title, detail: `${doc.title} · ${doc.group}`, href: `/docs/${doc.slug}#${slug}`, keywords: `${doc.title} ${plain(content)}`, starter: false };
  })];
});
---
<dialog id="site-search" class="site-search-dialog" aria-labelledby="site-search-title">
  <div class="site-search-heading"><h2 id="site-search-title">Search domfx</h2><button data-search-close aria-label="Close search"><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-x"/></svg></button></div>
  <label class="site-search-field"><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-magnifying-glass"/></svg><input type="search" data-global-search aria-label="Search effects and documentation" placeholder="Try frost, GSAP, or reduced motion" aria-controls="site-search-results" autocomplete="off" autofocus/></label>
  <p class="site-search-status" role="status" aria-live="polite">Effects and documentation</p>
  <div id="site-search-results" class="site-search-results">
    <section data-search-group="effects" aria-labelledby="search-effects-heading">
      <h3 id="search-effects-heading">Effects</h3>
      <ul>{effects.map(({id, name, category}, index) => <li data-search-item data-search-kind="effects" data-title={name.toLowerCase()} data-keywords={`${name} ${category} effect`.toLowerCase()} data-starter={index < 4 ? 'true' : undefined}><button data-search-effect={id} data-id={id} data-name={name} data-category={category}><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-sparkle"/></svg><span><strong>{name}</strong><small>{category}</small></span><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></button></li>)}</ul>
    </section>
    <section data-search-group="documentation" aria-labelledby="search-docs-heading">
      <h3 id="search-docs-heading">Documentation</h3>
      <ul>{entries.map(entry => <li data-search-item data-search-kind="documentation" data-title={entry.title.toLowerCase()} data-keywords={entry.keywords.toLowerCase()} data-starter={entry.starter ? 'true' : undefined}><a href={entry.href}><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-book-open"/></svg><span><strong>{entry.title}</strong><small>{entry.detail}</small></span><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></li>)}</ul>
    </section>
  </div>
  <p class="site-search-empty" hidden>No matches. Try an effect name or a documentation topic.</p>
  <div class="site-search-hint"><span>↑ ↓ to move · Enter to open</span><span>Esc to close</span></div>
</dialog>
