---
import { effectReference } from '@domfx/site/effect-reference';
import type { Effect } from '@domfx/site/effects';
import { localeFromPath } from '@domfx/site/locale';

import { effectReferenceEs } from '../content/effect-reference-es';

interface Props {
  effects: readonly Effect[];
}

const { effects } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const reference = locale === 'es' ? effectReferenceEs : effectReference;
---
<ul class="docs-effect-links">
  {effects.map((effect) => <li>
    <a href={`/docs/${locale === 'es' ? 'es/' : ''}api/effects/${effect.id}`} data-category={effect.category}>
      <span class="docs-effect-link-name">{effect.name}<svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></span>
      <span class="docs-effect-link-detail">{reference[effect.id].description}</span>
      <code>{effect.exportName}</code>
    </a>
  </li>)}
</ul>
