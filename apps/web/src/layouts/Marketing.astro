---
import { browserInstallCommand } from '@domfx/site/published-versions';
import DiscoveryHead from '@domfx/site/components/discovery-head.astro';
import ControlBox from '@domfx/site/components/control-box.astro';
import ZoomChip from '@domfx/site/components/zoom-chip.astro';
import PhosphorIcons from '@domfx/site/components/phosphor-icons.astro';
import SiteNav from '@domfx/site/components/SiteNav.astro';
import { effects } from '@domfx/site/effects';
import { localeFromPath, localePath } from '@domfx/site/locale';
import { marketingPages } from '@domfx/site/marketing-pages';
import washer from '../assets/brand/washer.png';
import EffectCard from '../components/effect-card.astro';
import MarketingClosing from '../components/marketing-closing.astro';
import MarketingStory from '../components/marketing-story.astro';
import SiteSearch from '../components/site-search.astro';
import { marketingMessages } from '../content/marketing-copy';
import '../styles/marketing.css';

interface Props { surface?: 'marketing' | 'library' }
const { surface = 'marketing' } = Astro.props;
const isLibrary = surface === 'library';
const locale = localeFromPath(Astro.url.pathname);
const m = marketingMessages[locale];
const page = marketingPages(Astro.site?.href ?? 'http://127.0.0.1:4321', locale)[isLibrary ? 1 : 0];
const docsPath = (slug: 'api' | 'api/effects') => localePath({ kind: 'docs', slug }, locale);
const zoomLabels = { zoom: m.previewZoom, in: m.zoomIn, out: m.zoomOut, reset: m.resetZoom, pan: m.panPreview, left: m.panLeft, right: m.panRight, up: m.panUp, down: m.panDown };
---
<!doctype html>
<html lang={locale}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><DiscoveryHead page={page}/><meta name="theme-color" content="#14151B"/><link rel="icon" href="/favicon.svg"/><link rel="preload" href="/fonts/CabinetGrotesk-Medium.woff2" as="font" type="font/woff2" crossorigin/><script is:inline>document.documentElement.dataset.initialAudience = new URLSearchParams(location.search).get('audience') === 'agents' ? 'agents' : 'humans';</script></head>
<body class="marketing-page" id="top" data-surface={surface}>
<PhosphorIcons />
<a class="skip" href="#main">{m.skip}</a>
<SiteNav current={isLibrary ? 'effects' : undefined} decorated />
<main id="main">
  {!isLibrary && <section class="gallery-hero wrap">
    <div class="hero-copy"><h1 id="hero-title">{m.heroTitle}<br/>{m.heroTitleEnd}<span class="title-dot">.</span></h1><p>{m.heroDescription}<br/>{m.heroDescriptionEnd}</p></div>
    <div class="hero-start">
      <div class="audience-tabs" aria-label={m.getStarted}><a id="humans-tab" href="#humans-panel" data-audience="humans" aria-controls="humans-panel">{m.humans}</a><a id="agents-tab" href="#agents-panel" data-audience="agents" aria-controls="agents-panel">{m.agents}</a></div>
      <div class="audience-panels">
      <div id="humans-panel" aria-labelledby="humans-tab"><button class="install hero-command" data-copy={browserInstallCommand} aria-label={m.copyPackage}><code>{browserInstallCommand}</code><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-copy"/></svg></button><div class="hero-actions"><a class="button silver hero-action" href="#collection">{m.findEffect} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-down"/></svg></a><a class="button hero-star" href="https://github.com/G0m1namm/domfx" aria-label={`${m.star}: domfx`} title={`${m.star}: domfx`} data-repo-stars><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-star"/></svg><span data-star-label>{m.star}</span><span class="star-count" data-star-count hidden></span></a></div></div>
      <div id="agents-panel" aria-labelledby="agents-tab"><button class="install hero-command" data-copy="pnpm dlx skills add G0m1namm/domfx --skill domfx" aria-label={m.copySkill}><code>pnpm dlx skills add G0m1namm/domfx --skill domfx</code><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-copy"/></svg></button><p class="agent-preview-note">{m.skillNote}</p><a class="story-link" href={docsPath('api')}>{m.apiGuide} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></div>
      </div>
    </div>
  </section>}
  <span id="examples"></span><section id="collection" class:list={['wrap', 'gallery-collection', { 'library-collection': isLibrary }]}>
    <div class="collection-top">
      {isLibrary ? <h1>{m.effects}<span class="effect-count" data-count>{effects.length}</span></h1> : <h2>{m.exploreEffects}</h2>}
    </div>
    {isLibrary && <div class="collection-tools" data-js-control hidden><div class="filters" aria-label={m.categories}><button data-filter="All" aria-pressed="true">{m.allEffects} <span>{effects.length}</span></button><button data-filter="Energy" aria-pressed="false">{m.energy}</button><button data-filter="Material" aria-pressed="false">{m.material}</button><button data-filter="Pattern" aria-pressed="false">{m.patterns}</button></div></div>}
    <div class="effect-grid spotlight-grid gallery-grid">{(isLibrary ? effects : effects.slice(0, 5)).map((effect, index) => <EffectCard effect={effect} index={index} locale={locale}/>)}</div>
    {isLibrary ? <p class="empty" hidden>{m.noEffects}</p> : <div class="gallery-more"><a class="button" href={localePath({ kind: 'effects' }, locale)}>{m.exploreAll} {effects.length} {locale === 'es' ? 'efectos' : 'effects'} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></div>}
  </section>
{!isLibrary && <div id="supporting-content"><MarketingStory locale={locale}/></div>}
</main>
<div id="closing-content"><MarketingClosing locale={locale}/></div>
<noscript><p class="wrap">{m.noscript}</p></noscript>
<dialog class="effect-dialog" aria-labelledby="dialog-title" data-status="suspended" data-status-visible="false" data-paused="false">
{effects.map((effect) => <template data-box-template={effect.id}><ControlBox effect={effect} locale={locale} id={`preview-${effect.id}`} target="text"/></template>)}
<template data-preview-image><img src={washer.src} width="260" height="260" alt=""/></template>
<template data-preview-svg><svg width="260" height="260" viewBox="0 0 160 160" aria-hidden="true"><path fill="#C2C5DB" d="M64 8H96V45L122 19L145 42L119 68H156V100H119L145 126L122 149L96 123V160H64V123L38 149L15 126L41 100H4V68H41L15 42L38 19L64 45Z"/></svg></template>
<div class="dialog-top">
  <button data-close aria-label={m.closePreview}><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-x"/></svg></button>
  <div class="dialog-heading"><h2 id="dialog-title"></h2><a class="plain-link" data-effect-reference href={docsPath('api/effects')}>{m.effectReference} <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-up-right"/></svg></a></div>
  <p class="dialog-status" role="status"><span class="dialog-status-dot" aria-hidden="true"></span><span data-preview-status></span></p>
</div>
<div class="dialog-frame">
  <div class="dialog-scene" tabindex="0" role="region" aria-label={m.previewRegion} aria-describedby="preview-zoom-hint">
    <div class="dialog-stage" data-effect-host></div>
  </div>
  <ZoomChip helpId="preview-zoom-hint" labels={zoomLabels}><span class="hover-zoom-hint">{m.hoverInspect}</span><span class="touch-zoom-hint">{m.zoomInspect}</span></ZoomChip>
</div>
</dialog>
<SiteSearch locale={locale}/>
<div class="toast" role="status" hidden></div>
<script src="../scripts/marketing.ts"></script>
</body></html>
