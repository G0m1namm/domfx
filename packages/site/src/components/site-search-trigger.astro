---
import type { Locale } from '../locale';
import '../styles/site-search.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<button class="header-search" data-search-open data-js-control hidden aria-label={locale === 'es' ? 'Buscar efectos y documentación' : 'Search effects and documentation'} title={locale === 'es' ? 'Buscar efectos y documentación (⌘K / Ctrl+K)' : 'Search effects and docs (⌘K / Ctrl+K)'} aria-keyshortcuts="Meta+K Control+K" aria-haspopup="dialog" aria-controls="site-search"><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-magnifying-glass"/></svg></button>
