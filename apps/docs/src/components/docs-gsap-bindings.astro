---
import { localeFromPath } from '@domfx/site/locale';

import DocsApiTable from './DocsApiTable.astro';

const isEs = localeFromPath(Astro.url.pathname) === 'es';
---
<p>{isEs ? 'Importa' : 'Import'} <code>bindEffect</code> {isEs ? 'desde' : 'from'} <code>@domfx/gsap</code>. {isEs ? 'Acepta cualquier EffectHandle activo con control externo. Proporciona la instancia, una línea de tiempo GSAP bajo tu control y estas opciones:' : 'It accepts any live, externally controlled EffectHandle. Supply the effect instance, a caller-owned GSAP timeline and these options:'}</p>
<DocsApiTable label={isEs ? 'Opciones de enlace con GSAP' : 'GSAP binding options'}>
  <thead><tr><th scope="col">{isEs ? 'Propiedad' : 'Property'}</th><th scope="col">{isEs ? 'Tipo' : 'Type'}</th><th scope="col">{isEs ? 'Predeterminado' : 'Default'}</th></tr></thead>
  <tbody>
    <tr><th scope="row"><code>time</code><p>{isEs ? 'Tiempo de destino absoluto en segundos. Debe ser finito y representable como float32.' : 'Absolute destination time in seconds. Must be finite and representable as float32.'}</p></th><td><code>number</code></td><td>{isEs ? 'Obligatorio' : 'Required'}</td></tr>
    <tr><th scope="row"><code>intensity</code><p>{isEs ? 'Fuerza de destino finita. Se limita a 0–1 antes de interpolar.' : 'Finite destination strength. Clamped to 0–1 before interpolation.'}</p></th><td><code>number</code></td><td>{isEs ? 'Obligatorio' : 'Required'}</td></tr>
    <tr><th scope="row"><code>duration</code><p>{isEs ? 'Duración de interpolación finita y no negativa, en segundos. Se acepta cero.' : 'Finite, nonnegative interpolation duration in seconds. Zero is accepted.'}</p></th><td><code>number</code></td><td>{isEs ? 'Obligatorio' : 'Required'}</td></tr>
    <tr><th scope="row"><code>position</code><p>{isEs ? 'Posición de inserción en GSAP. Si se omite, se añade al final de la línea de tiempo.' : 'GSAP insertion position. Omitting it appends to the timeline.'}</p></th><td><code>gsap.Position</code></td><td><code>undefined</code></td></tr>
    <tr><th scope="row"><code>disposeEffect</code><p>{isEs ? 'Delega al enlace la responsabilidad de liberar el efecto, incluso al revertir el contexto.' : 'Give effect cleanup responsibility to the binding, including context revert.'}</p></th><td><code>boolean</code></td><td><code>false</code></td></tr>
  </tbody>
</DocsApiTable>
<p><code>bindEffect(effect, timeline, options)</code> {isEs ? 'devuelve un' : 'returns an'} <code>EffectBinding</code>. {isEs ? 'Toma una instantánea de los controles iniciales e interpola linealmente.' : 'It snapshots starting controls and interpolates linearly.'} <code>binding.dispose()</code> {isEs ? 'elimina su animación y una instancia cuya propiedad de limpieza se haya cedido expresamente; la línea de tiempo sigue a cargo de quien la creó.' : 'removes its tween and an explicitly owned attachment; the caller still owns the timeline.'}</p>
<p><code>bindEffectAsync(promise, timeline, options)</code> {isEs ? 'acepta una promesa de cualquier instancia de efecto y requiere' : 'accepts a promise of any effect handle and requires'} <code>disposeEffect: true</code>. {isEs ? 'Devuelve un' : 'It returns an'} <code>AsyncEffectBinding</code> {isEs ? 'con' : 'with'} <code>dispose()</code> {isEs ? 'y' : 'and'} <code>ready: Promise&lt;void&gt;</code>{isEs ? ', y libera los resultados que llegan después de cancelar. Usa' : ', releasing late results after cancellation. Use'} <code>context.revert()</code> {isEs ? 'para limpiar el contexto GSAP.' : 'for GSAP context cleanup.'}</p>
<p>{isEs ? 'Consulta la' : 'See the'} <a href={isEs ? '/docs/es/gsap' : '/docs/gsap'}>{isEs ? 'guía de GSAP' : 'GSAP guide'}</a> {isEs ? 'para ver una secuencia completa y su limpieza.' : 'for a complete sequence and teardown.'}</p>
<p><code>bindFire</code>, <code>bindFireAsync</code> {isEs ? 'y los tipos con nombre Fire siguen siendo alias compatibles. Ambos nombres conservan el mismo comportamiento de instantánea.' : 'and the Fire-named types remain aliases for compatibility. Both names preserve the same snapshot behavior.'}</p>
<p class="docs-api-note">{isEs ? 'Estas funciones son adaptadores, no plugins registrados de propiedades GSAP. Animan objetivos proxy privados:' : 'These helpers are adapters, not registered GSAP property plugins. They animate private proxy targets:'} <code>gsap.killTweensOf(effect)</code> {isEs ? 'y la sobrescritura entre enlaces no afectan a sus animaciones hijas. Varios enlaces creados juntos capturan los mismos controles iniciales; usa llamadas nativas a' : 'and cross-binding overwrite do not address their children. Multiple bindings created together snapshot the same starting controls; use native'} <code>.to()</code> {isEs ? 'para secuencias encadenadas normales.' : 'calls for normal chained sequencing.'}</p>
<p>{isEs ? 'Matar únicamente la línea de tiempo del llamante no elimina la suscripción de liberación del enlace. Libera también el enlace. El' : "Killing the caller's timeline alone does not remove a binding's disposal subscription. Dispose the binding too. An asynchronous binding's"} <code>ready</code> {isEs ? 'de un enlace asíncrono espera la configuración del enlace o la limpieza de un resultado tardío, no la configuración inicial del propio efecto.' : "waits for binding setup or late-result cleanup, not the effect's own initial setup."}</p>
