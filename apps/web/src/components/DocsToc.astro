---
import type { TocHeading } from '../content/table-of-contents';

interface Props {
  headings: readonly TocHeading[];
}

const { headings } = Astro.props;
---
<nav class="docs-toc-list" aria-label="On this page">
  <ul>
    {headings.map((heading) => <li data-depth={heading.depth}><a href={`#${heading.id}`} data-toc-link={heading.id}>{heading.text}</a></li>)}
  </ul>
</nav>
