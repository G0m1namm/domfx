{
  "name": "domfx-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "GPU edge effects for live DOM elements.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/G0m1namm/domfx.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "agent:brief": "node scripts/agent-harness.mjs brief",
    "agent:verify": "node scripts/agent-harness.mjs verify",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:artifacts": "node scripts/check-release-artifacts.mjs",
    "release:handoff": "node scripts/check-release-artifacts.mjs --handoff",
    "release:rehearse": "pnpm build && node scripts/rehearse-release.mjs",
    "release:verify:registry": "node scripts/rehearse-release.mjs --registry",
    "release:check": "pnpm check && pnpm build:web:built && pnpm release:status && pnpm release:artifacts",
    "build": "pnpm --filter \"./packages/**\" -r build",
    "build:demo": "pnpm build:web",
    "preview:demo": "pnpm preview:web",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm lint:boundaries && pnpm test:tooling && node scripts/test-packed-contracts.mjs && pnpm -r typecheck && pnpm -r test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "test": "pnpm build && pnpm -r test",
    "test:packed": "pnpm build && node scripts/test-packed-consumer.mjs",
    "test:packed:contracts": "pnpm build && node scripts/test-packed-contracts.mjs",
    "demo": "pnpm web",
    "lint:boundaries": "node scripts/check-workspaces.mjs && depcruise --config dependency-cruiser.config.mjs packages apps tests",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:browser": "pnpm test:gpu:full",
    "test:browser:built": "pnpm test:gpu:built",
    "hooks:install": "lefthook install",
    "prepare": "lefthook install",
    "measure:steady": "node tests/gpu/scripts/measure-performance.mjs --steady",
    "measure:layout": "node tests/gpu/scripts/measure-layout.mjs",
    "measure:homepage": "node scripts/measure-homepage.mjs",
    "measure:performance": "node tests/gpu/scripts/measure-performance.mjs",
    "test:browser:evidence": "node tests/gpu/scripts/browser-regression.mjs",
    "web": "pnpm build && pnpm --filter @domfx/web dev",
    "build:web": "pnpm build && pnpm --filter @domfx/web build",
    "preview:web": "pnpm --filter @domfx/web preview",
    "test:web": "pnpm build:web && pnpm --filter @domfx/web test:browser",
    "test:browser:smoke": "pnpm test:gpu",
    "test:browser:smoke:built": "pnpm --filter @domfx/gpu-tests exec playwright test --project production --grep @smoke",
    "build:demo:built": "pnpm build:web:built",
    "build:web:built": "pnpm --filter @domfx/web build",
    "build:gpu": "pnpm build && pnpm build:gpu:built",
    "build:gpu:built": "pnpm --filter @domfx/gpu-tests build",
    "test:gpu": "pnpm build:gpu && pnpm --filter @domfx/gpu-tests exec playwright test --project production --grep @smoke",
    "test:gpu:full": "pnpm build:gpu && pnpm test:gpu:built",
    "test:gpu:built": "pnpm --filter @domfx/gpu-tests test:browser",
    "test:web:smoke": "pnpm build:web && pnpm test:web:smoke:built",
    "test:web:smoke:built": "pnpm --filter @domfx/web exec playwright test smoke.spec.ts",
    "test:visual": "pnpm build:web && pnpm --filter @domfx/web exec playwright test --config playwright.visual.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "dependency-cruiser": "18.2.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.5.0"
}
