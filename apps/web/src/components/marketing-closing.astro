---
import asterisk from '../assets/brand/asterisk.png';
import { footerLinkGroups } from '@domfx/site/site-links';

const year = new Date().getFullYear();
---
<div class="closing-design afterglow">
  <section class="closing-cta afterglow-cta wrap" aria-labelledby="closing-title">
    <div class="closing-word-stage" data-closing-host aria-hidden="true"><img data-closing-target class="closing-artwork" src={asterisk.src} width="380" height="285" alt="" /></div>
    <h2 id="closing-title">Give your next page<br/>an expressive edge.</h2>
    <p>One element is all it takes to start.</p>
    <div class="closing-actions"><button class="button silver" data-copy="pnpm add @domfx/browser"><code>pnpm add @domfx/browser</code><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-copy"/></svg></button><a class="closing-link" href="/docs/standalone/">Read the setup guide <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-right"/></svg></a></div>
  </section>
  <footer class="closing-footer wrap">
    <div class="footer-navigation"><div class="footer-intro"><a class="wordmark" href="/">domfx<img class="brand-mark" src="/brand-mark.svg" width="30" height="30" alt="" aria-hidden="true" /></a><p>Effects for your HTML.</p><button class="closing-playback" data-closing-pause data-js-control hidden aria-label="Pause header and artwork effects" aria-pressed="false"><svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-pause"/></svg><span>Pause effects</span></button></div>{footerLinkGroups.map(group=><nav aria-label={`Footer ${group.title}`}><h3>{group.title}</h3>{group.items.map(([label, href])=><a href={href}>{label}{href.startsWith('https://') && <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-up-right"/></svg>}</a>)}</nav>)}</div>

    <div class="footer-baseline"><span>© {year} domfx</span><span class="footer-credit">Made by <a href="https://github.com/G0m1namm">Jherson Martelo Medina</a></span><a href="#">Back to top <svg class="ui-icon" viewBox="0 0 256 256" aria-hidden="true"><use href="#ph-arrow-up"/></svg></a></div>
  </footer>
</div>
